allow init usercalib_file:dir mounton;
allow vendor_init usercalib_file:dir create_dir_perms;

allow raydium mnt_vendor_file:dir search;
allow raydium usercalib_file:dir create_dir_perms;
allow raydium usercalib_file:file create_file_perms;
allow raydium vendor_data_file:lnk_file read;

# vold runs fstrim over all mounted volumes during idle maintenance. The
# usercalib partition only holds the factory calibration and is not
# trimmed; keep the denied read of its root out of the log.
dontaudit vold usercalib_file:dir read;
